# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule (^|/)\.litespeed_conf\. - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheLookup on
# Aislamiento de caché por subdominio: el host viaja en cada request (incluido
# el primero), a diferencia de la cookie _lscache_vary que se fija recién en la
# respuesta. Se combina con no-autoflush en una sola regla E=Cache-Control para
# no pisar la directiva previa (dos E=Cache-Control se sobrescriben).
RewriteRule .* - [E="Cache-Control:no-autoflush,vary=host%{HTTP_HOST}"]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker REST AUTH start ###
RewriteCond %{HTTP:Authorization} !^$
RewriteCond %{REQUEST_URI} /wp\-json(?:/|$) [OR]
RewriteCond %{QUERY_STRING} (^|&)rest_route=
RewriteRule .* - [E=Cache-Control:no-cache]
### marker REST AUTH end ###

### marker POSTPASS start ###
RewriteCond %{HTTP_COOKIE} (^|;\s*)wp-postpass_2f4eff60b09091db01b3e477dd9c80fe=
RewriteRule .* - [E=Cache-Control:no-cache]
### marker POSTPASS end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
