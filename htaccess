# === IDIOMA POR PAIS (subdominio -> idioma) ===
<IfModule mod_rewrite.c>
	RewriteEngine On

	# BR: /pt/ -> raiz (evita duplicado; la raiz ya se sirve en pt via idioma-raiz.php)
	RewriteCond %{HTTP_HOST} ^br\.muyunicos\.com$ [NC]
	RewriteRule ^pt/?$ / [R=301,L]

	# US: /en/ -> raiz (evita duplicado; la raiz ya se sirve en en via idioma-raiz.php)
	RewriteCond %{HTTP_HOST} ^us\.muyunicos\.com$ [NC]
	RewriteRule ^en/?$ / [R=301,L]

	# Paises hispanos: /pt/ y /en/ -> raiz (evita duplicados)
	RewriteCond %{HTTP_HOST} ^(mexico|co|es|cl|pe|ec|cr)\.muyunicos\.com$ [NC]
	RewriteRule ^(pt|en)(?:/(.*))?$ /$2 [R=301,L]
</IfModule>

